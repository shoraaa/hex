{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hexbench.local/schemas/map-config.json",
  "title": "HEXUDON map configuration",
  "type": "object",
  "required": ["startsAt", "daySeconds", "daySteps", "map", "spots", "agents", "fuelLimits", "players", "busyThreshold", "jammedThreshold"],
  "properties": {
    "startsAt": {"type": "number"},
    "agent_selection_time_limit": {"type": "number", "minimum": 0},
    "daySeconds": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
    "daySteps": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "map": {
      "type": "object",
      "required": ["height", "width", "cells"],
      "properties": {
        "height": {"type": "integer", "minimum": 8, "maximum": 32},
        "width": {"type": "integer", "minimum": 8, "maximum": 32},
        "cells": {"type": "array", "items": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 3}}}
      },
      "additionalProperties": false
    },
    "spots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["brand", "pos", "stocks"],
        "properties": {
          "brand": {"type": "integer", "minimum": 0},
          "pos": {"type": "integer", "minimum": 0},
          "stocks": {"type": "integer", "minimum": 1, "maximum": 8}
        },
        "additionalProperties": false
      }
    },
    "agents": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"type": "integer", "minimum": 0}},
    "fuelLimits": {"type": "integer", "minimum": 1},
    "players": {"type": "integer", "minimum": 1},
    "busyThreshold": {"type": "integer", "minimum": 1, "maximum": 5},
    "jammedThreshold": {"type": "integer", "minimum": 2, "maximum": 10}
  },
  "additionalProperties": false
}
